---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';
import { getAllPublishers } from '../lib/publishers';

export const prerender = true;

const games = await getAllGames(getDatabase());
const publishers = await getAllPublishers(getDatabase());
const categories = [...new Map(
  games
    .filter((game) => game.category !== null)
    .map((game) => [game.category!.id, game.category!]),
).values()].sort((left, right) => left.name.localeCompare(right.name));
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <form class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-6 shadow-lg" data-testid="game-filters">
            <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
              <fieldset>
                <legend class="mb-3 text-lg font-medium text-slate-100">Filter by category</legend>
                <div class="flex flex-wrap gap-3">
                  {categories.map((category) => (
                    <label class="inline-flex cursor-pointer items-center gap-2 rounded-lg border border-slate-600 px-3 py-2 text-sm text-slate-200 transition-colors hover:border-blue-400 focus-within:ring-2 focus-within:ring-blue-500">
                      <input
                        type="checkbox"
                        name="category"
                        value={category.id}
                        class="h-4 w-4 accent-blue-500"
                        data-testid="category-filter"
                      />
                      {category.name}
                    </label>
                  ))}
                </div>
              </fieldset>

              <div class="flex flex-col gap-2">
                <label for="publisher-filter" class="text-lg font-medium text-slate-100">Filter by publisher</label>
                <select
                  id="publisher-filter"
                  name="publisher"
                  class="min-w-56 rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
                  data-testid="publisher-filter"
                >
                  <option value="">All publishers</option>
                  {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
                </select>
              </div>

              <button
                type="reset"
                class="rounded-lg border border-slate-600 px-4 py-2 text-sm font-medium text-slate-200 transition-colors hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500"
                data-testid="reset-filters"
              >
                Reset filters
              </button>
            </div>
            <p class="mt-4 text-sm text-slate-400" role="status" aria-live="polite" data-testid="filter-results">
              Showing {games.length} games
            </p>
          </form>

          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
          <p class="hidden py-12 text-center text-slate-400" data-testid="filter-empty">No games match the selected filters.</p>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const filterForm = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  const categoryFilters = Array.from(document.querySelectorAll<HTMLInputElement>('[data-testid="category-filter"]'));
  const publisherFilter = document.querySelector<HTMLSelectElement>('[data-testid="publisher-filter"]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
  const results = document.querySelector<HTMLElement>('[data-testid="filter-results"]');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="filter-empty"]');

  function applyFilters(): void {
    if (!publisherFilter || !results || !emptyState) return;

    const selectedCategories = categoryFilters
      .filter((filter) => filter.checked)
      .map((filter) => filter.value);
    const selectedPublisher = publisherFilter.value;
    let visibleCount = 0;

    cards.forEach((card) => {
      const categoryMatches = selectedCategories.length === 0 || selectedCategories.includes(card.dataset.gameCategoryId ?? '');
      const publisherMatches = selectedPublisher === '' || selectedPublisher === card.dataset.gamePublisherId;
      const isVisible = categoryMatches && publisherMatches;
      card.hidden = !isVisible;
      if (isVisible) visibleCount += 1;
    });

    results.textContent = `Showing ${visibleCount} game${visibleCount === 1 ? '' : 's'}`;
    emptyState.hidden = visibleCount !== 0;
  }

  filterForm?.addEventListener('change', applyFilters);
  filterForm?.addEventListener('reset', () => requestAnimationFrame(applyFilters));
</script>
